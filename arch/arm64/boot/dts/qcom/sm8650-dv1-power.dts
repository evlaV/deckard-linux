		"",  "",  "te2_right",  "",  "", "", "", "", "", "", "", "", "", "";
};

&i2c5 {
    // BOOT EEPROM
    eeprom@50 {
        compatible  = "atmel,24c32";
        status      = "okay";
        label		= "core_eeprom";
        reg         = <0x50>;
		pagesize    = <32>;
		size        = <4096>;
		address-width = <16>;
        wp-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
        vcc-supply  = <&vreg_l15b_1p8>;
    };

    max34417_1: max34417@12 {
        compatible = "maxim,max34417";
        reg = <0x12>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&vreg_l2b_3p0>;
        vio-supply = <&vreg_l15b_1p8>;
        status = "okay";

        // CH 1 : Kryo APC0 Cores
        // CH 2 : Kryo APC2 Cores
        // CH 3 : Kryo APC1 Cores
        // CH 4 : Tensor Processor – NSP1
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    };

    max34417_2: max34417@1a {
        compatible = "maxim,max34417";
        reg = <0x1a>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&vreg_l2b_3p0>;
        vio-supply = <&vreg_l15b_1p8>;
        status = "okay";

        // CH 1 : GFX Power
        // CH 2 : Tensor Processor – NSP2
        // CH 3 : Bob Power
        // CH 4 : Unused
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    };

    // TODO enable verr ( varies based on common mode range )
    max34417_3: max34417@10 {
        compatible = "maxim,max34417";
        reg = <0x10>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&vreg_l2b_3p0>;
        vio-supply = <&vreg_l15b_1p8>;
        status = "okay";

        // CH 1 : VPH
        // CH 2 : S6C ~1.9V Subregulation
        // CH 3 : S3C ~1.3V Subregulation
        // CH 4 : S1C ~1V Subregulation
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    }; 
};

// Custom Connector I2C ( Paddle Card )
&i2c2 {
	status = "okay";

	// Southgate/Northgate Primary Built In Battery
	max17320_primary@36 {
		compatible  = "maxim,max17320";
		status		= "okay";
		reg         = <0x36>;
		nvm_reg     = /bits/ 8 <0x0b>;
		rsense      = <25>;      /* 100's of microOhms */
	};

	// Southgate/Northgate Secondary Hotswap Battery
	// NOTE This is handled dynamically by northgate_hotswap driver
	// max17320_hotswap@76 {
	//	compatible  = "maxim,max17320";
	//	status		= "okay";
	//	reg         = <0x76>;
	//	nvm_reg     = /bits/ 8 <0x4b>;
	//	rsense      = <25>;      /* 100's of microOhms */
	// };

    // PADDLE EEPROM
    eeprom@50 {
        compatible  = "atmel,24c32";
        status      = "okay";
		label		= "strap_eeprom";
        reg         = <0x50>;
        //wp-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
        vcc-supply  = <&vreg_l15b_1p8>;
    };

	// PADDLE EEPROM - 256 Bytes on 0x51 added in EV3.3
	eeprom@51 {
		compatible  = "atmel,24c04";
		status      = "okay";
		label       = "strap_v2_eeprom";
		reg         = <0x51>;
		vcc-supply  = <&vreg_l15b_1p8>;
	};


};


