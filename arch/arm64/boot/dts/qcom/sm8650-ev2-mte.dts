&dispcc {
	status = "okay";
};

&gpi_dma1 {
	status = "okay";
};


&camss {
	status = "okay";

	vdda-csi01-0p9-supply = <&vreg_l2i_0p88>;
	vdda-csi01-1p2-supply = <&vreg_l3i_1p2>;
	vdda-csi24-0p9-supply = <&vreg_l2i_0p88>;
	vdda-csi24-1p2-supply = <&vreg_l3i_1p2>;

	ports {
		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;

			csiphy0_ep: endpoint@0 {
				reg = <0>;
				clock-lanes = <4>;
				data-lanes = <0 1>;
				remote-endpoint = <&cam_6dof_l>;
			};

			csiphy0_combo_ep: endpoint@1 {
				reg = <1>;
				clock-lanes = <3>;
				data-lanes = <2>;
				remote-endpoint = <&cam_6dof_ul>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;

			csiphy1_ep: endpoint@0 {
				reg = <0>;
				clock-lanes = <4>;
				data-lanes = <0 1>;
				remote-endpoint = <&cam_6dof_r>;
			};

			csiphy1_combo_ep: endpoint@1 {
				reg = <1>;
				clock-lanes = <3>;
				data-lanes = <2>;
				remote-endpoint = <&cam_6dof_ur>;
			};
		};


	};
};

&cci0 {
	status = "okay";
};

&cci1 {
	pinctrl-0 = <&cci1_0_default>;
	pinctrl-1 = <&cci1_0_sleep>;
	status = "okay";
};

#define USERSPACE_EYETRACKING

#ifdef USERSPACE_EYETRACKING
&camss {
	ports {
		port@2 {
			#address-cells = <1>;
			#size-cells = <0>;

			csiphy2_ep: endpoint {
				clock-lanes = <4>;
				data-lanes = <0>;
				remote-endpoint = <&cam_et_l>;
			};
		};

		port@4 {
			csiphy4_ep: endpoint {
				clock-lanes = <4>;
				data-lanes = <0>;
				remote-endpoint = <&cam_et_r>;
			};
		};
	};
};

&cci0_i2c1 {
	sensor@60 {
		compatible = "ovti,ov6710";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK4_CLK>;
		clock-names = "xclk";
		reset-gpios = <&tlmm 195 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam4_default>;
		pinctrl-names = "default";
		avdd-supply = <&vreg_l6n_2p8>;
		dovdd-supply = <&eyetck_dovdd_1v8>;
		dvdd-supply = <&vreg_l1n_1p1>;
		id = "eyetracking_left";

		port {
			cam_et_l: endpoint {
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <240000000>;
				remote-endpoint = <&csiphy2_ep>;
			};
		};
	};
};

&cci1_i2c0 {
	sensor@60 {
		compatible = "ovti,ov6710";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK2_CLK>;
		clock-names = "xclk";
		reset-gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&cam2_default>;
		pinctrl-names = "default";
		avdd-supply = <&vreg_l6m_2p8>;
		dovdd-supply = <&eyetck_dovdd_1v8>;
		dvdd-supply = <&vreg_l1m_1p1>;
		id = "eyetracking_right";

		port {
			cam_et_r: endpoint {
				data-lanes = <1>;
				link-frequencies = /bits/ 64 <240000000>;
				remote-endpoint = <&csiphy4_ep>;
			};
		};
	};
};
#endif

&cci2 {
	status = "okay";
};


&cci2_i2c0 {
	sensor@60 {
		compatible = "ovti,og01a1bx";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		clock-names = "xclk";
		reset-gpios = <&pm8550vs_e_gpios 6 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 123 GPIO_ACTIVE_HIGH>;
		sensor-queue-index = <0>;
		ircontrol-gpios = <&tlmm 200 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam1_default>;
		pinctrl-names = "default";
		AVDD-supply = <&vreg_l3n_2p8>;
		DOVDD-supply = <&vreg_6dof_1p8_l>;
		DVDD-supply = <&vreg_6dof_1p2_l>;
		id = "slam_left";

		dual-i2c-available = <1>;
		dual-i2c-main = <1>;
		
		port {
			cam_6dof_l: endpoint {
				clock-lanes = <4>;
				data-lanes = <0 1>;
				link-frequencies = /bits/ 64 <500000000>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};

	sensor@36 {
		compatible = "ovti,og01a1bx";
		reg = <0x36>;
		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "xclk";
		reset-gpios = <&pm8550vs_e_gpios 4 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 121 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam0_default>;
		pinctrl-names = "default";
		AVDD-supply = <&vreg_l3m_2p8>;
		DOVDD-supply = <&vreg_6dof_1p8_r>;
		DVDD-supply = <&vreg_6dof_1p2_r>;
		id = "slam_right";
		sensor-queue-index = <0>;

		dual-i2c-available = <1>;
		dual-i2c-main = <0>;
		
		port {
			cam_6dof_r: endpoint {
				data-lanes = <0 1>;
				clock-lanes = <4>;
				link-frequencies = /bits/ 64 <500000000>;
				remote-endpoint = <&csiphy1_ep>;
			};
		};
	};
};

&cci2_i2c1 {
	clock-frequency = <400000>;
	sensor@60 {
		compatible = "ovti,og0ve10x";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK3_CLK>;
		clock-names = "xclk";
		reset-gpios = <&pm8550vs_c_gpios 5 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam3_default>;
		pinctrl-names = "default";
		AVDD-supply = <&vreg_l4n_2p8>;
		DOVDD-supply = <&vreg_6dof_1p8_ul>;
		DVDD-supply = <&vreg_6dof_1p2_ul>;
		sensor-queue-index = <1>;
		id = "upper_left";
	
		dual-i2c-available = <1>;
		dual-i2c-main = <1>;
		
		port {
			cam_6dof_ul: endpoint {
				clock-lanes = <3>;
				data-lanes = <2>;
				link-frequencies = /bits/ 64 <500000000>;
				remote-endpoint = <&csiphy0_combo_ep>;
			};
		};
	};
	
	sensor@3e {
		compatible = "ovti,og0ve10x";
		reg = <0x3E>;
		clocks = <&camcc CAM_CC_MCLK5_CLK>;
		clock-names = "xclk";
		reset-gpios = <&pm8550vs_c_gpios 6 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 68 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam5_default>;
		pinctrl-names = "default";
		AVDD-supply = <&vreg_l4m_2p8>;
		DOVDD-supply = <&vreg_6dof_1p8_ur>;
		DVDD-supply = <&vreg_6dof_1p2_ur>;

		sensor-queue-index = <1>;
		id = "upper_right";

		dual-i2c-available = <1>;
		dual-i2c-main = <0>;

		port {
			cam_6dof_ur: endpoint {
				clock-lanes = <3>;
				data-lanes = <2>;
				link-frequencies = /bits/ 64 <500000000>;
				remote-endpoint = <&csiphy1_combo_ep>;
			};
		};
	};
};

&gpu {
	status = "okay";
};

// Master Hub required for Hub 7 and 8
&i2c_master_hub_0 {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_mdp {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3i_1p2>;
	status = "okay";

	qcom,dual-dsi-mode;
	qcom,master-dsi;


	panel: panel@0 {
		reg = <0>;
		compatible = "pocf,jdi-lpm026m648c";
		dual-panel;

		reset-gpios = <&pm8550_gpios 3 GPIO_ACTIVE_HIGH>,
			      <&pm8550_gpios 11 GPIO_ACTIVE_HIGH>;

		//Bias supplies enabled via GPIO
		left-pos-supply = <&vpos_l>;
		left-neg-supply = <&vneg_l>;
		right-pos-supply = <&vpos_r>;
		right-neg-supply = <&vneg_r>;

		preboost-supply = <&BACKLIGHT_PREBOOST>;
		backlight-left-supply = <&backlight_left>;
		backlight-right-supply = <&backlight_right>;

		vdda-supply = <&vreg_l12b_1p8>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				panel0_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				panel1_in: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l1i_0p88>;
	phy-type = <PHY_TYPE_CPHY>;
	status = "okay";
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l3i_1p2>;
	status = "okay";

	qcom,dual-dsi-mode;

	assigned-clocks = <&dispcc DISP_CC_MDSS_BYTE1_CLK_SRC>, <&dispcc DISP_CC_MDSS_PCLK1_CLK_SRC>;
	assigned-clock-parents = <&mdss_dsi0_phy 0>, <&mdss_dsi0_phy 1>;
};

&mdss_dsi1_out {
	remote-endpoint = <&panel1_in>;
	data-lanes = <0 1 2>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l1i_0p88>;
	status = "okay";
	phy-type = <PHY_TYPE_CPHY>;
};

&pcie0 {
	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcieport0 {
	wifi@0 {
		compatible = "pci17cb,1107";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
	};
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1i_0p88>;
	vdda-pll-supply = <&vreg_l3i_1p2>;

	status = "okay";
};

&pm8550_gpios {
	sdc2_card_det_n: sdc2-card-det-state {
		pins = "gpio12";
		function = "normal";
		bias-pull-up;
		input-enable;
		output-disable;
		power-source = <1>; /* 1.8 V */
	};

	volume_up_n: volume-up-n-state {
		pins = "gpio6";
		function = "normal";
		bias-pull-up;
		input-enable;
		power-source = <1>;
	};
};

&pm8550b_gpios {
	select_n: select-n-state {
		pins = "gpio5";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};

	detect_n: detect-n-state {
		pins = "gpio6";
		function = "normal";
		power-source = <1>;
		bias-pull-up;
		input-enable;
	};
};

&pm8550b_eusb2_repeater {
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;
};

&pm8550b_vbus {
	status = "okay";
};

&pm8550b_typec {
	status = "okay";

	vdd-pdphy-supply = <&vreg_l5b_3p1>;

	connector {
		power-role = "source";
		data-role = "dual";
		try-power-role = "source";
		
		source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_DUAL_ROLE | PDO_FIXED_DATA_SWAP | PDO_FIXED_USB_COMM)>;

		op-sink-microwatt = <15000000>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				pm8550b_role_switch_out: endpoint {
					remote-endpoint = <&usb_1_dwc3_hs>;
				};
			};

			port@1 {
				reg = <1>;

				tcpm_sbu_out: endpoint {
					remote-endpoint = <&sbu_mux_in>;
				};
			};

#if 0
			port@2 {
				reg = <2>;

				dp_mode_out: endpoint {
					remote-endpoint = <&dp_mode>;
				};
			};


			port@1 {
				reg = <1>;

				pm8550b_typec_mux_out: endpoint {
					remote-endpoint = <&usb_1_qmpphy_typec_mux_in>;
				};
			};
#endif
		};
	};

};

&pm8550b_charger {
	status = "okay";
	qph1-charge-current-max = <1200000>;
	qph2-charge-current-max = <2700000>;
};

&pmk8550_rtc {
	status = "okay";
	allow-set-time;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;

	status = "okay";
};

&qup_spi10_cs {
	pins = "gpio13", "gpio15";
};

&qupv3_id_0 {
	status = "okay";
};

&qupv3_id_1 {
	status = "okay";
};



&sdhc_2 {
	cd-gpios = <&pm8550_gpios 12 GPIO_ACTIVE_LOW>;

	vmmc-supply = <&vreg_l9b_2p9>;
	vqmmc-supply = <&vreg_l8b_1p8>; // actually level shifter
	bus-width = <4>;
	no-sdio;
	no-mmc;

	pinctrl-0 = <&sdc2_default>, <&sdc2_card_det_n>;
	pinctrl-1 = <&sdc2_sleep>, <&sdc2_card_det_n>;
	pinctrl-names = "default", "sleep";

	status = "okay";
};

&sleep_clk {
	clock-frequency = <32764>;
};

// nRF SPI HID
&spi10 {
	status = "okay";

	// L, on QUP2 SE2 L3 CS
	// expansion, CS_2=gpio_15
	hid@2 {
		compatible = "hid-over-spi";
		reg = <2>;
		interrupts-extended = <&tlmm 69 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 70 GPIO_ACTIVE_LOW>;
		input-report-header-address = <0x1000>;
		input-report-body-address = <0x1004>;
		output-report-address = <0x2000>;
		read-opcode = <0x0b>;
		write-opcode = <0x02>;
		hid-over-spi-flags = <0x00>;
		post-power-on-delay-ms = <1>;
		minimal-reset-delay-ms = <100>;
		pinctrl-names = "default";
		pinctrl-0 = <&l_spihid_default_state>;
	};

	// R, on QUP2 SE2 L6 CS
	// mainboard, CS_1=gpio_13
	hid@1 {
		compatible = "hid-over-spi";
		reg = <1>;
		interrupts-extended = <&tlmm 66 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 137 GPIO_ACTIVE_LOW>;
		input-report-header-address = <0x1000>;
		input-report-body-address = <0x1004>;
		output-report-address = <0x2000>;
		read-opcode = <0x0b>;
		write-opcode = <0x02>;
		hid-over-spi-flags = <0x00>;
		post-power-on-delay-ms = <1>;
		minimal-reset-delay-ms = <100>;
		pinctrl-names = "default";
		pinctrl-0 = <&r_spihid_default_state>;
	};
};

&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7850-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		max-speed = <3200000>;
	};
};

&i2c4 {
	status = "okay";
	
    /* FAN_I2C */
	slg4ax46073v@8 {
		compatible = "silego,slg4ax46073v";
		reg = <0x08>;
		#address-cells = <1>;
		#size-cells = <0>;

		//vdd-fan-1-supply = <&VBATT_2S>; not modeled in dts
		fan-alert-gpios = <&tlmm 174 GPIO_ACTIVE_HIGH>;
		en-gpio = <&tlmm 138 GPIO_ACTIVE_HIGH>;
		// bp pin removed in ev1

		status = "disabled";
	};

	/* 3D Hall Sensor I2C */
	als31300@6c {
		compatible = "allegro,als31300";
		reg = <0x6c>;
		#address-cells = <1>;
		#size-cells = <0>;

		vdd-hall-supply = <&vreg_l2b_3p0>; 
		//hall-alert-gpios = <&tlmm 65 GPIO_ACTIVE_LOW>; // Not Used

		status = "okay";
	};

	// right backlight
	mpq3367_right@38 {
		compatible = "mps,mpq3367";
		reg = <0x38>;
		status = "okay";
		en-gpios = <&pm8550_gpios 1 GPIO_ACTIVE_HIGH>;
		mode = "pwm";
		regulator {
			backlight_right: backlight{
				regulator-name = "backlight_right";
			};
		};
	};

	mp3317@28{
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "mps,mp3317";
		reg = <0x28>;
		en-gpios = <&tlmm 58 GPIO_ACTIVE_HIGH>;

		status = "okay";
	};
};

&i2c5 {
	status = "okay";
	// left backlight
	mpq3367_left@38 {
		compatible = "mps,mpq3367";
		reg = <0x38>;
		status = "okay";
		en-gpios = <&pm8550_gpios 2 GPIO_ACTIVE_HIGH>;
		mode = "pwm";
		regulator {
			backlight_left: backlight{
				regulator-name = "backlight_left";
			};
		};
	};
};

&uart15 {
	status = "okay";
};

// Prox Sensor I2C
&i2c_hub_8 {
	status = "okay";

	light-sensor@60 {
		compatible = "vishay,vcnl4040";
		reg = <0x60>;
		proximity-near-level = <220>;
		// interrupts-extended = <&tlmm 31 IRQ_TYPE_EDGE_FALLING>;
		// driver lacks support for regulators, l8c and l11c set to always on

		vin0-supply = <&vreg_l2b_3p0>; 
		vin1-supply = <&vreg_l15b_1p8>; 

		status = "okay";
	};
};

&lpass_tlmm {
	status = "okay";
};

&lpass_vamacro {
	pinctrl-0 = <&dmic01_default>;
	pinctrl-names = "default";
	vdd-micb-supply = <&vreg_l10b_1p8>;
	qcom,dmic-sample-rate = <2400000>; /* or 3200000 */
};

&sound {
    enable-i2s;
    // enable-hdmi;
    codecs =
       <&left_spkr_i2s>, <&right_spkr_i2s>,
       <&lpass_vamacro 0>;

    pinctrl-0 = <&i2s2_active>;
    pinctrl-names = "default";
};

&i2c_hub_8 {
    /* MAX98390 */
    right_spkr_i2s: speaker@38 {
        compatible = "maxim,max98390";
        reg = <0x38>;
        maxim,temperature_calib = <1024>; // TODO
        maxim,r0_calib = <100232>; // TODO
        reset-gpios = <&tlmm 73 GPIO_ACTIVE_LOW>;
        // irq-gpios = <&tlmm 186 GPIO_ACTIVE_LOW>;  XXX TODO add IRQ support to driver, set as open drain
        #sound-dai-cells = <0>;
        sound-name-prefix = "Speaker Right";
    };

    /* MAX98390 */
    left_spkr_i2s: speaker@3d {
        compatible = "maxim,max98390";
        reg = <0x3d>;
        maxim,temperature_calib = <1024>; // TODO
        maxim,r0_calib = <100232>; // TODO
        reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
        // irq-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;  XXX TODO add IRQ support to driver, set as open drain
        #sound-dai-cells = <0>;
        sound-name-prefix = "Speaker Left";
    };
};

// Disable Soundwire
&wsa_swr_active {
	status = "disabled";
};

&tlmm {
	// TODO verify reserved pins for 8650
	// qcom,gpios-reserved = <36 37 38 39>;
	gpio-line-names =
		// GPIO000 - GPIO015
		"",  "",  "",  "",  "",  "",  "",  "fpga_rst",  "",  "",  "",  "nrf_time_sync",  "",  "",  "",  "",
		// GPIO016 - GPIO031
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO032 - GPIO047
		"",  "",  "",  "fpga_spi_cs",  "",  "",  "",  "fpga_crst",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO048 - GPIO063
		"",  "",  "nrf_swdio",  "nrf_swclk",  "",  "",  "",  "",  "fpga_cam0_strobe",  "fpga_cam1_strobe",  "",  "",  "",  "",  "",  "",
		// GPIO064 - GPIO079
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO080 - GPIO095
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO096 - GPIO111
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "fpga_cam1_frame_sync",  "",
		// GPIO112 - GPIO127
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "fpga_cam0_frame_sync",  "",  "",  "",
		// GPIO128 - GPIO143
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO144 - GPIO159
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "fpga_cdone",  "",  "",  "fpga_cready",  "",
		// GPIO160 - GPIO175
		"",  "",  "",  "",  "nrf_reset",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO176 - GPIO189
		"",  "",  "",  "",  "", "", "", "", "", "", "", "", "", "";
};

&tlmm {
	FPGA_clk_pins {
		FPGA_clk_default: fpga_clk_default {
			mux {
				pins = "gpio88";
				function = "gcc_gp3";
			};
			config {
				pins = "gpio88";
				drive-strength = <6>;
				bias-pull-none; /* pull none */
			};
		};
		FPGA_clk_active: fpga_clk_active {
			mux {
				pins = "gpio88";
				function = "gcc_gp3";
			};
			config {
				pins = "gpio88";
				drive-strength = <2>; /* 2 mA */
				bias-pull-none; /* pull none */
			};
		};
		FPGA_clk_sleep: fpga_clk_sleep {
			mux {
				pins = "gpio88";
				function = "gpio";
			};
			config {
				pins = "gpio88";
				drive-strength = <2>; /* 2 mA */
				bias-pull-down; /* pull down */
			};
		};
	};
};


&pcie1 {
	vdda-supply = <&vph_pwr>;
	vddpe-3v3-supply = <&vph_pwr>; // XXX

	wake-gpios = <&tlmm 99 GPIO_ACTIVE_HIGH>;
	perst-gpios = <&tlmm 97 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&pcie1_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie1_phy {
	vdda-phy-supply = <&vreg_l3e_0p9>;
	vdda-pll-supply = <&vreg_l3i_1p2>;
	vdda-qref-supply = <&vreg_l1i_0p88>;

	status = "okay";
};

&i2c5 {
    // BOOT EEPROM
    eeprom@50 {
        compatible  = "atmel,24c32";
        status      = "okay";
        label		= "core_eeprom";
        reg         = <0x50>;
        wp-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
        vcc-supply  = <&vreg_l15b_1p8>;
    };

	// Northgate/Enthusiast Paddle Card Silego
	slg46534v@48 {
			compatible = "silego,northgate";
			reg = <0x48>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "ok";
	};
};

&i2c5 {
    max34417_1: max34417@12 {
        compatible = "maxim,max34417";
        reg = <0x12>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&vreg_l2b_3p0>;
        vio-supply = <&vreg_l15b_1p8>;
        status = "okay";

        // CH 1 : Kryo APC1 Cores
        // CH 2 : Kryo APC2 Cores
        // CH 3 : Kryo APC0 Cores
        // CH 4 : Tensor Processor – NSP1
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    };

    max34417_2: max34417@1a {
        compatible = "maxim,max34417";
        reg = <0x1a>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&vreg_l2b_3p0>;
        vio-supply = <&vreg_l15b_1p8>;
        status = "okay";

        // CH 1 : GFX Power
        // CH 2 : Tensor Processor – NSP2
        // CH 3 : VPH Power
        // CH 4 : Unused
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    };

    // TODO enable verr ( varies based on common mode range )
    max34417_3: max34417@10 {
        compatible = "maxim,max34417";
        reg = <0x10>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&vreg_l2b_3p0>;
        vio-supply = <&vreg_l15b_1p8>;
        status = "okay";

        // CH 1 : BOB
        // CH 2 : S6C ~1.9V Subregulation
        // CH 3 : S1C ~1.3V Subregulation
        // CH 4 : S3C ~1V Subregulation
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    }; 
};

// Custom Connector I2C ( Paddle Card )
&i2c2 {
	status = "okay";
	max17320@36 {
		compatible  = "maxim,max17320";
		status				= "okay";
		reg         = <0x36>;
		rsense      = <25>;      /* 100's of microOhms */
		// talrt-min   = <0>;       /* DegreeC */
		// talrt-max   = <50>;      /* DegreeC */
		// valrt-min   = <3000>;    /* mV */
		// valrt-max   = <4500>;    /* mV */
		// salrt-min   = <1>;       /* Percent */
		// salrt-max   = <99>;      /* Percent */
		// ialrt-min   = <(-5000)>; /* mA */
		// ialrt-max   = <5000>;    /* mA */
	};

    // PADDLE EEPROM
    eeprom@50 {
        compatible  = "atmel,24c32";
        status      = "okay";
		label		= "strap_eeprom";
        reg         = <0x50>;
        //wp-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
        vcc-supply  = <&vreg_l15b_1p8>;
    };

	// Northgate/Enthusiast Paddle Card Silego
	slg46534v@48 {
		compatible = "silego,northgate";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;

		status = "ok";
	};
};

&pm8550ve_gpios {
	gpio-line-names =
		// GPIO01 - GPIO08
		"",  "",  "",  "",  "",  "",  "",  "";
};

&spi0 {
	status = "okay";

	// Remove Hardware Chip Select
	pinctrl-0 = <&qup_spi0_data_clk>;

	cspi@0 {
		status = "okay";
		compatible = "linux,spidev";
		spi-max-frequency = <11000000>;
		reg = <0>;
	};
};


&tlmm {
	status = "okay";

	// FPGA Pins
	fpga_rst: fpga_rst {
		mux {
			pins = "gpio7";
			function = "gpio";
		};

		config {
			pins = "gpio7";
			bias-disable = <0>;
			drive-strength = <2>;
			output-enable;
			ouput-high;
		};
	};

	fpga_cs: fpga_cs {
		mux {
			pins = "gpio35";
			function = "gpio";
		};

		config {
			pins = "gpio35";
			bias-disable = <0>;
			drive-strength = <2>;
			output-enable;
			// active-low;
			output-high;
		};
	};

	fpga_crst: fpga_crst {
		mux {
			pins = "gpio39";
			function = "gpio";
		};

		config {
			pins = "gpio39";
			bias-disable = <0>;
			input-enable;
		};
	};

	fpga_cdone: fpga_cdone {
		mux {
			pins = "gpio155";
			function = "gpio";
		};

		config {
			pins = "gpio155";
			bias-disable = <0>;
			input-enable;
		};
	};	

	fpga_cready: fpga_cready {
		mux {
			pins = "gpio158";
			function = "gpio";
		};

		config {
			pins = "gpio158";
			bias-disable = <0>;
			input-enable;
		};
	};
};

// nRF Pins
&tlmm {
	// nRF CS
	qup_spi10_cs_nrf: qup-spi10-cs-state-nrf {
		pins = "gpio13", "gpio15";
		function = "qup2_se2";
		drive-strength = <6>;
		bias-disable;
	};

	// nRF SPI interrupt and reset pins

    	// expansion 
	l_spihid_default_state: l-spihid-default {
		irq0-pins {
			pins = "gpio69";
			function = "gpio";
			bias-pull-up;
		};

		reset0-pins {
			pins = "gpio70";
			function = "gpio";
			drive-strength = <2>;
			output-low;
			bias-pull-down;
		};
	};

	// host/mainboard
	r_spihid_default_state: r-spihid-default {
		irq0-pins {
			pins = "gpio66";
			function = "gpio";
			bias-pull-up;
		};

		reset0-pins {
			pins = "gpio137";
			function = "gpio";
			drive-strength = <2>;
			output-low;
			bias-pull-down;
		};
	};

	nrf_host_rst_n: nrf_host_rst_n {
		mux {
			pins = "gpio164";
			function = "gpio";
		};

		config {
			pins = "gpio164";
			power-source = <1>; /* 1.8 V */
			bias-disable = <0>;
			output-enable;
			output-low;
		};
	};
	
	bt_default: bt-default-state {
		bt-en-pins {
			pins = "gpio17";
			function = "gpio";
			drive-strength = <16>;
			bias-disable;
		};

		sw-ctrl-pins {
			pins = "gpio18";
			function = "gpio";
			bias-pull-down;
		};
	};

	i2c4_default: i2c4-default-state {
		pins = "gpio48", "gpio49";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	i2c5_default: i2c5-default-state {
		pins = "gpio52", "gpio53";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1c_1p2>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1d_0p9>;
	vdda-pll-supply = <&vreg_l3i_1p2>;

	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
};


&usb_1_hsphy {
	vdd-supply = <&vreg_l1i_0p88>;
	vdda12-supply = <&vreg_l3i_1p2>;

	phys = <&pm8550b_eusb2_repeater>;

	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l3i_1p2>;
	vdda-pll-supply = <&vreg_l3g_0p91>;

	orientation-switch;

	status = "okay";
};

&xo_board {
	clock-frequency = <76800000>;
};
