/*
 * Remove:
 * - SCPI power management nodes
 * - Remove DSP & LPASS nodes until DSP can be enabled without TZ
 * Disable:
 * - LPASS & Audio nodes, could be re-enabled with lpass-cpu implementation
 * TODO:
 * - fix cDSP & aDSP to boot without SCM
 */

#include <dt-bindings/clock/qcom,lpasscorecc-sm8550.h>

/ {
	cpus {
		/delete-node/ idle-states;
		/delete-node/ domain-idle-states;
	};

	// /delete-node/ firmware;
	/delete-node/ reserved-memory;

	reserved-memory {
		ranges;

		#address-cells = <2>;
		#size-cells = <2>;

		aop_mem: aop@81c00000 {
			no-map;
			reg = <0x0 0x81c00000 0x0 0x60000>;
		};

		ramoops: ramoops@84a00000 {
			compatible = "ramoops";
			reg = <0 0x84a00000 0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			pmsg-size = <0x1000>;
			max_reason = <5>;
			ecc-size = <16>;
		};

		aop_cmd_db_mem: aop-cmd-db@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x0 0x81c60000 0x0 0x20000>;
			no-map;
		};

		/* merged aop_config, tme_crash_dump, tme_log */
		aop_config_merged_mem: aop-config-merged-region@81c80000 {
			//reg = <0x0 0x81c80000 0x0 0x64000>;
			reg = <0x0 0x81c80000 0x0 0x75000>;
			no-map;
		};

		smem: smem@81d00000 {
			compatible = "qcom,smem";
			reg = <0x0 0x81d00000 0x0 0x200000>;
			hwlocks = <&tcsr_mutex 3>;
			no-map;
		};

		cpucp_fw_mem: cpucp-fw@d8040000 {
			reg = <0x0 0xd8040000 0x0 0x1b2000>;
			no-map;
		};

		video_mem: video@9bb00000 {
			reg = <0 0x9bb00000 0 0x800000>;
			no-map;
		};

		tz_stat_mem: tz-stat@82700000 {
			reg = <0 0x82700000 0 0x100000>;
			no-map;
		};
	};

	psci {
		/delete-node/ power-domain-cpu0;
		/delete-node/ power-domain-cpu1;
		/delete-node/ power-domain-cpu2;
		/delete-node/ power-domain-cpu3;
		/delete-node/ power-domain-cpu4;
		/delete-node/ power-domain-cpu5;
		/delete-node/ power-domain-cpu6;
		/delete-node/ power-domain-cpu7;
		/delete-node/ power-domain-cluster;
	};

	/delete-node/ smp2p-adsp;
	/delete-node/ smp2p-cdsp;
	/delete-node/ smp2p-modem;

	soc@0 {
		/delete-node/ timer@17420000;

		restart@c264000 {
			compatible = "qcom,pshold";
			reg = <0 0x0c264000 0 0x4>;
		};

		audiocc: clock-controller@6bc8000 {
			reg = <0 0x06bc8000 0 0x30000>;
			compatible = "qcom,sm8550-audiocc";
			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>, // depend on lpasscc probe??
				 <&bi_tcxo_div2>;
			clock-names = "iface", "bi_tcxo";
			power-domains = <&aoncc LPASS_AUDIO_HM_GDSCR>;
			#clock-cells = <1>;
		};

		aoncc: clock-controller@6e08000 {
			reg = <0 0x06e08000 0 0x30000>;
			compatible = "qcom,sm8550-aoncc";
			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
				 <&bi_tcxo_div2>;
			clock-names = "iface", "bi_tcxo";
			power-domains = <&lpass_hm LPASS_CORE_HM_GDSCR>;
			#clock-cells = <1>;
			#power-domain-cells = <1>;
		};

		lpasscc: clock-controller@7b08000 {
			compatible = "qcom,sm8550-lpasscorecc";
			reg = <0 0x07b08000 0 0x4f000>;
			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
				 <&bi_tcxo_div2>;
			clock-names = "iface", "bi_tcxo";
			power-domains = <&lpass_hm LPASS_CORE_HM_GDSCR>;
			#clock-cells = <1>;
		};

		lpass_hm: clock-controller@7e00000 {
			compatible = "qcom,sm8550-lpasshm";
			reg = <0 0x07e00000 0 0xa000>;
			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
				 <&bi_tcxo_div2>;
			clock-names = "iface", "bi_tcxo";
			#clock-cells = <1>;
			#power-domain-cells = <1>;
			power-domains = <&rpmhpd RPMHPD_LCX>;
		};

		sound: lpass@6b80000 {
			compatible = "qcom,sm8650-lpass";

			// LPASS_WSA_2CH_LPA_IF: 0x06a00000
			// LPASS_AUD_LPA_IF: 0x06a40000
			// LPASS_RXTX_LPA_IF: 0x06b40000
			// LPASS_WSA_LPA_IF: 0x06b80000
			// LPASS_VA_LPA_IF: 0x06d00000
			// LPASS_CORE_LPA_IF: 0x07d00000 (mi2s)

			// LPASS_HDMITX: 0x07be8000 (lpaif)
			// LPASS_HDMITX_CTL: 0x07b88000


			// LPASS_CORE_LPM: 0x07C10000 + 0x8000 (32K)
			// LPASS_AUDIO_LPM 0x06C80000 + 0x10000 (64K)
			// LPASS_VA_LPM 0x06D40000 + 0x3000 (12K)

			reg = <0 0x06b80000 0 0x29000>,
			      <0 0x06C80000 0 0xc000>, // wrong size (0x10000)
			      <0 0x06d00000 0 0x29000>,
			      <0 0x06D40000 0 0x3000>,
			      <0 0x07b88000 0 0x1000>, // wrong size?
			      <0 0x07be8000 0 0x7000>, // wrong size?
			      <0 0x07d00000 0 0x29000>,
			      <0 0x07C10000 0 0x8000>;
			reg-names = "wsa-lpaif",
				    "wsa-lpm",
				    "va-lpaif",
				    "va-lpm",
				    "hdmi-ctl",
				    "hdmi-lpaif",
				    "mi2s-lpaif",
				    "hdmi-mi2s-lpm";

			power-domains = <&lpass_hm LPASS_CORE_HM_GDSCR>;

			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
				 <&lpasscc LPASS_CORE_CC_SYSNOC_MPORT_CORE_CLK>,
				 <&lpass_wsamacro>,
				 <&lpass_vamacro>,
				 <&lpasscc LPASS_CORE_CC_EXT_IF2_IBIT_CLK>,
				 <&audiocc LPASS_AUDIO_CC_EXT_IF2_IBIT_CLK>;
			clock-names = "pcnoc-sway-clk",
				"pcnoc-mport-clk",
				"wsa-mclk",
				"va-mclk",
				"mi2s-ter-ibit",
				"mi2s-sen-ibit";

			interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 268 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "wsa-lpaif",
					  "va-lpaif",
					  "hdmi-lpaif",
					  "mi2s-lpaif";
		};
	};
};

&apps_rsc {
	/delete-property/ power-domains;
};

&cpu0 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu1 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu2 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu3 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu4 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu5 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu6 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

&cpu7 {
	/delete-property/ power-domains;
	/delete-property/ power-domain-names;
};

/delete-node/ &ipa;

&lpass_wsa2macro {
	/delete-property/ clocks;
	status = "disabled";
};

&lpass_rxmacro {
	/delete-property/ clocks;
	status = "disabled";
};

&lpass_txmacro {
	/delete-property/ clocks;
	status = "disabled";
};

&lpass_wsamacro {
	clocks = <&audiocc LPASS_AUDIO_CC_WSA_MCLK_CLK>,
		 <&audiocc LPASS_AUDIO_CC_WSA_2X_MCLK_CLK>,
		 <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
		 <&lpasscc LPASS_CORE_CC_SYSNOC_MPORT_CORE_CLK>,
		 <&aoncc LPASS_AON_CC_TX_MCLK_CLK>,
		 <&lpass_vamacro>;
	clock-names = "mclk",
		      "npl",
		      "macro",
		      "dcodec",
		      "va",
		      "fsgen";
};

&lpass_vamacro {
	clocks = <&aoncc LPASS_AON_CC_TX_MCLK_CLK>,
		 <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
		 <&lpasscc LPASS_CORE_CC_SYSNOC_MPORT_CORE_CLK>;
	clock-names = "mclk",
		      "macro",
		      "dcodec";
};

&lpass_tlmm {
	clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>;
	clock-names = "core";
};

&iris {
	video-firmware {
		iommus = <&apps_smmu 0x1942 0x0000>;
	};
};

/delete-node/ &remoteproc_adsp;
/delete-node/ &remoteproc_cdsp;
/delete-node/ &remoteproc_mpss;

&gpu {
	/* Take in account SMMU aperture registers */
	reg = <0x0 0x03d00000 0x0 0x61000>,
	      <0x0 0x03d9e000 0x0 0x2000>,
	      <0x0 0x03d61000 0x0 0x800>;

	/delete-node/ zap-shader;
};

/* Specify QUP/GPI firmware file */

&gpi_dma1 {
	firmware-name = "qcom/sm8650/qupv3fw.elf";
};

&gpi_dma2 {
	firmware-name = "qcom/sm8650/qupv3fw.elf";
};

&qupv3_id_0 {
	firmware-name = "qcom/sm8650/qupv3fw.elf";
};

&qupv3_id_1 {
	firmware-name = "qcom/sm8650/qupv3fw.elf";
};

&i2c_master_hub_0 {
	firmware-name = "qcom/sm8650/qupv3fw.elf";
};

/* PON PBS reboot mode */

&pmk8550_pon {
	compatible = "qcom,pmk8350-el2-pon", "qcom,pmk8350-pon";
};

&gpu {
	status = "disabled";
};

/* PON PBS reboot mode */

&pmk8550_pon {
	compatible = "qcom,pmk8350-el2-pon", "qcom,pmk8350-pon";
};
