		icp: icp@ac00000 {
			compatible = "qcom,sm8650-icp";

			reg = <0 0x0ac00000 0 0x10000>, // ICP
				  <0 0x0ac2c000 0 0xb000>,  // BPS
				  <0 0x0ac42000 0 0x18000>; // IPE
			reg-names = "icp",
						"bps",
						"ipe";

			mboxes = <&ipcc_computel0 IPCC_CLIENT_CAM 0>;

			interrupts-extended = <&intc GIC_SPI 463 IRQ_TYPE_EDGE_RISING>, 
								  <&ipcc_computel0 IPCC_CLIENT_CAM 0 IRQ_TYPE_EDGE_RISING>;
  			interrupt-names = "icp",
							  "ipcc";

			hwlocks = <&tcsr_mutex 10>; // synx hwspinlock

			power-domains = <&camcc TITAN_TOP_GDSC>,
					<&camcc BPS_GDSC>,
					<&camcc IPE_0_GDSC>;

			clocks = 
				<&gcc GCC_CAMERA_AHB_CLK>,
				<&gcc GCC_CAMERA_HF_AXI_CLK>,
				<&gcc GCC_CAMERA_SF_AXI_CLK>,
				<&camcc CAM_CC_CPAS_AHB_CLK>,
				<&camcc CAM_CC_CPAS_FAST_AHB_CLK>,
				<&camcc CAM_CC_CAMNOC_AXI_RT_CLK>,
				<&camcc CAM_CC_CAMNOC_AXI_NRT_CLK>,
				<&camcc CAM_CC_QDSS_DEBUG_XO_CLK>,
				// ICP clocks
				<&camcc CAM_CC_ICP_AHB_CLK>,
				<&camcc CAM_CC_ICP_CLK_SRC>,
				<&camcc CAM_CC_ICP_CLK>,
				// BPS clocks
				<&camcc CAM_CC_BPS_AHB_CLK>,
				<&camcc CAM_CC_BPS_FAST_AHB_CLK>,
				<&camcc CAM_CC_BPS_CLK_SRC>,
				<&camcc CAM_CC_BPS_CLK>,
				<&camcc CAM_CC_CPAS_BPS_CLK>,
				// IPE clocks
				<&camcc CAM_CC_IPE_NPS_AHB_CLK>,
				<&camcc CAM_CC_IPE_NPS_FAST_AHB_CLK>,
				<&camcc CAM_CC_IPE_NPS_CLK_SRC>,
				<&camcc CAM_CC_IPE_NPS_CLK>,
				<&camcc CAM_CC_IPE_PPS_FAST_AHB_CLK>,
				<&camcc CAM_CC_IPE_PPS_CLK>,
				<&camcc CAM_CC_CPAS_IPE_NPS_CLK>;

			clock-names =
				"gcc_ahb_clk",
				"gcc_axi_hf",
				"gcc_axi_sf",
				"cpas_ahb",
				"cpas_fast_ahb",
				"camnoc_axi_rt",
				"camnoc_axi_nrt",
				"qdss_debug_xo",
				// ICP clocks
				"icp_ahb",
				"icp_src",
				"icp",
				// BPS clocks
				"bps_ahb",
				"bps_fast_ahb",
				"bps_src",
				"bps",
				"cpas_bps",
				// IPE clocks
				"ipe_nps_ahb",
				"ipe_nps_fast_ahb",
				"ipe_nps_src",
				"ipe_nps",
				"ipe_pps_fast_ahb",
				"ipe_pps",
				"cpas_ipe_nps";

			// 
			iommus = <&apps_smmu 0x1800 0x00>, // IPE
					 <&apps_smmu 0x1801 0x00>, // IPE
					 <&apps_smmu 0x1820 0x00>, // BPS
					 <&apps_smmu 0x1840 0x00>, // IPE CDM
					 <&apps_smmu 0x1880 0x00>, // BPS CDM
					 <&apps_smmu 0x18C0 0x00>; // ICP

			interconnects = <&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
							<&mmss_noc MASTER_CAMNOC_ICP QCOM_ICC_TAG_ALWAYS &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
			interconnect-names = "cam_sf_0_mnoc",
								 "cam_sf_icp_mnoc";
		};

		camcc: clock-controller@ade0000 {
			compatible = "qcom,sm8650-camcc";
			reg = <0 0x0ade0000 0 0x20000>;
			clocks = <&gcc GCC_CAMERA_AHB_CLK>,
				 <&bi_tcxo_div2>,
				 <&bi_tcxo_ao_div2>,
				 <&sleep_clk>;
			power-domains = <&rpmhpd RPMHPD_MMCX>;
			required-opps = <&rpmhpd_opp_low_svs>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			#power-domain-cells = <1>;
			//status = "disabled";
		};
#endif

		pdc: interrupt-controller@b220000 {
			compatible = "qcom,sm8650-pdc", "qcom,pdc";
			reg = <0 0x0b220000 0 0x30000>, <0 0x174000f0 0 0x64>;

			interrupt-parent = <&intc>;

			qcom,pdc-ranges = <0 480 94>, <94 609 31>,
					  <125 63 1>, <126 716 12>,
					  <138 251 5>, <143 244 4>;

			#interrupt-cells = <2>;
			interrupt-controller;
		};

		tsens0: thermal-sensor@c228000 {
			compatible = "qcom,sm8650-tsens", "qcom,tsens-v2";
			reg = <0 0x0c228000 0 0x1000>, /* TM */
			      <0 0x0c222000 0 0x1000>; /* SROT */

			interrupts = <GIC_SPI 506 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 640 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "uplow",
					  "critical";

			#qcom,sensors = <15>;

			#thermal-sensor-cells = <1>;
		};

		tsens1: thermal-sensor@c229000 {
			compatible = "qcom,sm8650-tsens", "qcom,tsens-v2";
			reg = <0 0x0c229000 0 0x1000>, /* TM */
			      <0 0x0c223000 0 0x1000>; /* SROT */

			interrupts = <GIC_SPI 507 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 641 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "uplow",
					  "critical";

			#qcom,sensors = <16>;

			#thermal-sensor-cells = <1>;
		};

		tsens2: thermal-sensor@c22a000 {
			compatible = "qcom,sm8650-tsens", "qcom,tsens-v2";
			reg = <0 0x0c22a000 0 0x1000>, /* TM */
