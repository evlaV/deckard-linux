/dts-v1/;

// Includes sm8650-mp.dts instead of copying it, so the two cannot drift.
#include "sm8650-mp.dts"

//fw_setenv DTB_QCOM sm8650-mp-dbg.dtb

// Custom Connector I2C ( Paddle Card ): external power monitors
&i2c2 {
	broadcaster2: broadcaster@2c {
		compatible = "i2c-sw-broadcaster";
		reg = <0x2c>;
	};

	max34417_ext0: max34417@14 {
		compatible = "maxim,max34417";
		reg = <0x14>;
		maxim,sense-resistor = <1>;
		vdd-supply = <&vreg_l2b_3p0>;
		vio-supply = <&vreg_l15b_1p8>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		broadcaster-parent = <&broadcaster2>;

		// CH 1 : VDD_CX (S8I 0p73)
		// CH 2 : APC2
		// CH 3 : DDR VDD_2H
		// CH 4 : VDD_MX_A (S3I_0p75)
		input@0 {
			reg = <0>;
			label = "ext_vdd_cx";
			shunt-resistor = <10>;
		};

		input@1 {
			reg = <1>;
			label = "ext_apc2";
			shunt-resistor = <5>;
		};

		input@2 {
			reg = <2>;
			label = "ext_ddr_vdd_2h";
			shunt-resistor = <10>;
		};

		input@3 {
			reg = <3>;
			label = "ext_vdd_mx_a";
			shunt-resistor = <5>;
		};
	};

	max34417_ext1: max34417@1c {
		compatible = "maxim,max34417";
		reg = <0x1c>;
		maxim,sense-resistor = <1>;
		vdd-supply = <&vreg_l2b_3p0>;
		vio-supply = <&vreg_l15b_1p8>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		broadcaster-parent = <&broadcaster2>;

		// CH 1 : MXC(S3D_0p75)
		// CH 2 : VDD_MODEM (S5G_S6G_0p73)
		// CH 3 : APC1
		// CH 4 : APC0
		input@0 {
			reg = <0>;
			label = "ext_mxc";
			shunt-resistor = <5>;
		};

		input@1 {
			reg = <1>;
			label = "ext_vdd_modem";
			shunt-resistor = <5>;
		};

		input@2 {
			reg = <2>;
			label = "ext_apc1";
			shunt-resistor = <5>;
		};

		input@3 {
			reg = <3>;
			label = "ext_apc0";
			shunt-resistor = <10>;
		};
	};
};
