	sensor@60 {
		compatible = "ovti,og01a1bx";
		reg = <0x60>;
		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		clock-names = "xclk";
		reset-gpios = <&pm8550vs_e_gpios 6 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 123 GPIO_ACTIVE_HIGH>;
		ircontrol-gpios = <&tlmm 200 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&cam1_default>;
		pinctrl-names = "default";
		AVDD-supply = <&vreg_l3n_2p8>;
		DOVDD-supply = <&vreg_6dof_1p8_l>;
		DVDD-supply = <&vreg_6dof_1p2_l>;
		sensor-queue-index = <0>;
		id = "slam_left";

		dual-i2c-available = <0>;
		dual-i2c-main = <0>;

		port {
