#endif


		lpass_wsamacro: codec@6b00000 {
			compatible = "qcom,sm8650-lpass-wsa-macro";
			reg = <0 0x06b00000 0 0x1000>;
#if 0
			clocks = <&q6prmcc LPASS_CLK_ID_WSA_CORE_TX_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
				 <&q6prmcc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
				 <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
				 <&lpass_vamacro>;
			clock-names = "mclk", "macro", "dcodec", "fsgen";

			assigned-clocks = <&q6prmcc LPASS_CLK_ID_WSA_CORE_TX_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
			assigned-clock-rates = <19200000>;
#endif
			clocks = <&audiocc LPASS_AUDIO_CC_WSA_MCLK_CLK>,
				 <&audiocc LPASS_AUDIO_CC_WSA_2X_MCLK_CLK>,
				 <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
 				 <&lpasscc LPASS_CORE_CC_SYSNOC_MPORT_CORE_CLK>,
				 <&aoncc LPASS_AON_CC_TX_MCLK_CLK>,
				 <&lpass_vamacro>;

			clock-names = "mclk", "npl", "macro", "dcodec", "va", "fsgen";

			#clock-cells = <0>;
			clock-output-names = "mclk";
			pinctrl-names = "default";
			pinctrl-0 = <&wsa_swr_active>;
			#sound-dai-cells = <1>;
		};

		swr0: soundwire-controller@6b10000 {
			compatible = "qcom,soundwire-v2.1.0";
			reg = <0 0x06b10000 0 0x10000>;
			interrupts = <GIC_SPI 170 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&lpass_wsamacro>;
			clock-names = "iface";
			label = "WSA";

			qcom,din-ports = <4>;
			qcom,dout-ports = <9>;

			qcom,ports-sinterval =		/bits/ 16 <0x07 0x1f 0x3f 0x07 0x1f 0x3f 0x18f 0xff 0xff 0x0f 0x0f 0xff 0x31f>;
			qcom,ports-offset1 =		/bits/ 8 <0x01 0x03 0x05 0x02 0x04 0x15 0x00 0xff 0xff 0x06 0x0d 0xff 0x00>;
			qcom,ports-offset2 =		/bits/ 8 <0xff 0x07 0x1f 0xff 0x07 0x1f 0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
			qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0x08 0xff 0xff 0xff 0xff 0xff 0x0f>;
			qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0x08 0xff 0xff 0xff 0xff 0xff 0x0f>;
			qcom,ports-word-length =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0x08 0xff 0xff 0xff 0xff 0xff 0x18>;
			qcom,ports-block-pack-mode =	/bits/ 8 <0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x00 0x00 0x01 0x01 0x00 0x00>;
			qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff>;
			qcom,ports-lane-control =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff>;

			#address-cells = <2>;
			#size-cells = <0>;
			#sound-dai-cells = <1>;
			status = "disabled";
		};

		lpass_vamacro: codec@6d44000 {
			compatible = "qcom,sm8650-lpass-va-macro";
			reg = <0 0x06d44000 0 0x1000>;
#if 0
			clocks = <&q6prmcc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
				 <&q6prmcc LPASS_HW_MACRO_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
				 <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
			clock-names = "mclk", "macro", "dcodec";

			assigned-clocks = <&q6prmcc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
			assigned-clock-rates = <19200000>;
#endif
			clocks = <&aoncc LPASS_AON_CC_TX_MCLK_CLK>,
				 <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
				 <&lpasscc LPASS_CORE_CC_SYSNOC_MPORT_CORE_CLK>;

			clock-names = "mclk", "macro", "dcodec";

			#clock-cells = <0>;
			clock-output-names = "fsgen";
			#sound-dai-cells = <1>;
		};

		lpass_tlmm: pinctrl@6e80000 {
			compatible = "qcom,sm8650-lpass-lpi-pinctrl";
			reg = <0 0x06e80000 0x0 0x17000>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&lpass_tlmm 0 0 23>;

			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>;
			clock-names = "core";

			wsa_swr_active: wsa-swr-active-pins {
				clk {
					pins = "gpio10";
					function = "wsa_swr_clk";
					drive-strength = <2>;
					slew-rate = <1>;
					bias-disable;
				};

				data {
					pins = "gpio11";
					function = "wsa_swr_data";
					drive-strength = <2>;
					slew-rate = <1>;
					bias-bus-hold;

				};
			};

			wsa_swr_sleep: wsa-swr-sleep-pins {
				clk {
					pins = "gpio10";
					function = "wsa_swr_clk";
					drive-strength = <2>;
					input-enable;
					bias-pull-down;
				};

				data {
					pins = "gpio11";
					function = "wsa_swr_data";
					drive-strength = <2>;
					input-enable;
					bias-pull-down;

				};
			};
		};

		sound: lpass@6b80000 {
			compatible = "qcom,sm8650-lpass";

			// LPASS_WSA_2CH_LPA_IF: 0x06a00000
			// LPASS_AUD_LPA_IF: 0x06a40000
			// LPASS_RXTX_LPA_IF: 0x06b40000
			// LPASS_WSA_LPA_IF: 0x06b80000
			// LPASS_VA_LPA_IF: 0x06d00000
			// LPASS_CORE_LPA_IF: 0x07d00000 (mi2s)

			// LPASS_HDMITX: 0x07be8000 (lpaif)
			// LPASS_HDMITX_CTL: 0x07b88000


			// LPASS_CORE_LPM: 0x07C10000 + 0x8000 (32K)
			// LPASS_AUDIO_LPM 0x06C80000 + 0x10000 (64K)
			// LPASS_VA_LPM 0x06D40000 + 0x3000 (12K)

			reg = <0 0x06b80000 0 0x29000>,
			      <0 0x06C80000 0 0xc000>, // wrong size (0x10000)
			      <0 0x06d00000 0 0x29000>,
			      <0 0x06D40000 0 0x3000>,
			      <0 0x07b88000 0 0x1000>, // wrong size?
			      <0 0x07be8000 0 0x7000>, // wrong size?
			      <0 0x07d00000 0 0x29000>,
			      <0 0x07C10000 0 0x8000>;

			reg-names = "wsa-lpaif", "wsa-lpm",
				    "va-lpaif", "va-lpm",
				    "hdmi-ctl", "hdmi-lpaif",
				    "mi2s-lpaif", "hdmi-mi2s-lpm";

			power-domains = <&lpass_hm LPASS_CORE_HM_GDSCR>;

			clocks = <&gcc GCC_LPASS_CFG_NOC_SWAY_CLK>,
				 <&lpasscc LPASS_CORE_CC_SYSNOC_MPORT_CORE_CLK>,
				 <&lpass_wsamacro>,
				 <&lpass_vamacro>,
				 <&lpasscc LPASS_CORE_CC_EXT_IF2_IBIT_CLK>;

			clock-names = "pcnoc-sway-clk", "pcnoc-mport-clk", "wsa-mclk", "va-mclk", "mi2s-ter-ibit";

			interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 378 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 268 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "wsa-lpaif", "va-lpaif", "hdmi-lpaif", "mi2s-lpaif";
		};
	};

	mc_virt: interconnect-1 {
		compatible = "qcom,sm8550-mc-virt";
		#interconnect-cells = <2>;
		qcom,bcm-voters = <&apps_bcm_voter>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>; // downstream has 12 here
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	wlan_regulator: wlan-regulator {
		compatible = "regulator-wlan";
		regulator-name = "wlan";

		enable-gpio = <&tlmm 16 GPIO_ACTIVE_HIGH>;

		supply-count = <7>;

		vin0-supply = <&vreg_s3c_0p97>; // VDD_PMU_AON_I / VDD095_PMU_BT / VDD09_PMU_RFA_I
		vin1-supply = <&vreg_s4i_0p75>; // VDD095_PMU
		vin2-supply = <&vreg_s2c_0p85>; // VDD095_MX_PMU
		vin3-supply = <&vreg_s1c_1p25>; // VDD13_PMU_RFA_I / VDD13_PMU_PCIE_I
		vin4-supply = <&vreg_s6c_1p86>; // VDD19_PMU_RFA_I / VDD19_PMU_PCIE_I
		vin5-supply = <&vreg_l15b_1p8>; // VDD18_AON
		vin6-supply = <&vreg_l3c_1p2>; // VDD12_18_IO
		voltage-list = <916000 940000 976000 1316000 1864000 1800000 1200000>;
		// l6k: 1800000
		// s1c: 1316000
		// s6c: 1864000
		// s3c: 916000
		// s2c: 976000
		// s4i: 940000
		// l3c: 1200000
		// l15b: 1800000

		clocks = <&rpmhcc RPMH_RF_CLK1>;
		clock-names = "TCXOI";
	};

	dummy_codec: dummy_codec {
		compatible = "linux,snd-soc-dummy";
		#sound-dai-cells = <0>;
	};
};

#include "pm8010.dtsi"
#include "pm8550b.dtsi"
#include "pm8550vs.dtsi"
#include "pmk8550.dtsi"

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8550-rpmh-regulators";
		qcom,pmic-id = "b";

		vdd-bob1-supply = <&vph_pwr>;
		vdd-bob2-supply = <&vph_pwr>;
		vdd-l5-l16-supply = <&vreg_bob1>;
		vdd-l15-supply = <&vreg_s6c_1p86>;
		vdd-l17-supply = <&vreg_bob2>;

		vreg_bob1: bob1 {
			regulator-name = "vreg_bob1";
			regulator-min-microvolt = <3296000>; // note: min is 3008000, init is 3296000
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_bob2: bob2 {
			regulator-name = "vreg_bob2";
			regulator-min-microvolt = <2720000>; // note: min is 2704000, init is 2720000
			regulator-max-microvolt = <3008000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l01b_1p8: ldo1 {
			regulator-name = "vreg_l01b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;

			regulator-always-on; // XXX
		};

		vreg_l05b_3p1: ldo5 {
			regulator-name = "vreg_l05b_3p1";
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3104000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;

			regulator-always-on; // XXX
		};

		vreg_l11b_1p2: ldo11 {
			regulator-name = "vreg_l11b_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l12b_1p8: ldo12 {
			regulator-name = "vreg_l12b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l13b_3p0: ldo13 {
			regulator-name = "vreg_l13b_3p0";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l15b_1p8: ldo15 {
			regulator-name = "vreg_l15b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l17b_2p5: ldo17 {
			regulator-name = "vreg_l17b_2p5";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "c";

		vdd-s1-supply = <&vph_pwr>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;
		vdd-s5-supply = <&vph_pwr>;
		vdd-s6-supply = <&vph_pwr>;
		vdd-l1-supply = <&vreg_s1c_1p25>;
		vdd-l2-supply = <&vreg_s1c_1p25>;
		vdd-l3-supply = <&vreg_s1c_1p25>;

		vreg_s1c_1p25: smps1 {
			regulator-name = "vreg_s1c_1p25";
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1348000>;
			// init 1256000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;

			regulator-always-on; // USB, UFS?
		};

		vreg_s2c_0p85: smps2 {
			regulator-name = "vreg_s2c_0p85";
			regulator-min-microvolt = <500000>;
			regulator-max-microvolt = <1036000>;
			// init 852000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s3c_0p97: smps3 {
			regulator-name = "vreg_s3c_0p97";
			regulator-min-microvolt = <904000>;
			regulator-max-microvolt = <1064000>;
			// init 976000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s4c_1p2: smps4 {
			regulator-name = "vreg_s4c_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1280000>;
			// init 1224000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s5c_0p75: smps5 {
			regulator-name = "vreg_s5c_0p75";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <900000>;
			// init 752000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s6c_1p86: smps6 {
			regulator-name = "vreg_s6c_1p86";
			regulator-min-microvolt = <1856000>;
			regulator-max-microvolt = <2000000>;
			// init 1856000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1c_1p2: ldo1 {
			regulator-name = "vreg_l1c_1p2";
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1200000>;
			// init 1200000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3c_1p2: ldo3 {
			regulator-name = "vreg_l3c_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			// init 1200000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;

			regulator-always-on; // UFS, USB?
		};
	};

	regulators-2 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "d";

		vdd-l1-supply = <&vreg_s3c_0p97>;
		vdd-l2-supply = <&vreg_s3c_0p97>;
		vdd-l3-supply = <&vreg_s3c_0p97>;

		// note:
		// VREG_S5D_S6D_S1D_S2D_0P68 is VDD_GFX
		// VREG_S3D_0P75 is VDD_MXC
		// VREG_S4D_0P67 is VDD_LPI_CX
		// VREG_L2D_0P75 VDD_LPI_MX

		vreg_l1d_0p91: ldo1 {
			regulator-name = "vreg_l1d_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			// init 912000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-3 {
		compatible = "qcom,pm8550vs-rpmh-regulators";
		qcom,pmic-id = "d";

		vdd-l1-supply = <&vreg_s3c_0p97>;
		vdd-l2-supply = <&vreg_s3c_0p97>;
		vdd-l3-supply = <&vreg_s3c_0p97>;

		// note:
		// VREG_S1G_S2G_0P73 is VDD_NSP2
		// VREG_S3G_1P08 is LPDDR5_VDD2H
		// VREG_S4G_0P89 is VDDA_EBI
		// VREG_S5G_S6G_0P73 is VDD_MODEM

		vreg_l1g_0p91: ldo1 {
			regulator-name = "vreg_l1g_0p91";
			regulator-min-microvolt = <912000>;
			regulator-max-microvolt = <920000>;
			// init 912000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3g_0p91: ldo3 {
			regulator-name = "vreg_l3g_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			// init 880000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};


	regulators-4 {
		compatible = "qcom,pm8550ve-rpmh-regulators";
		qcom,pmic-id = "i";

		vdd-l1-supply = <&vreg_s3c_0p97>;
		vdd-l2-supply = <&vreg_s3c_0p97>;
		vdd-l3-supply = <&vreg_s1c_1p25>;
		vdd-s1-supply = <&vph_pwr>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;
		vdd-s4-supply = <&vph_pwr>;
		vdd-s5-supply = <&vph_pwr>;
		vdd-s6-supply = <&vph_pwr>;
		vdd-s7-supply = <&vph_pwr>;
		vdd-s8-supply = <&vph_pwr>;

		vreg_s4i_0p75: smps4 {
			regulator-name = "vreg_s4i_0p75";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1004000>;
			// init 852000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1i_0p88: ldo1 {
			regulator-name = "vreg_l1i_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			// init 880000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3i_1p2: ldo3 {
			regulator-name = "vreg_l3i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			// init 1200000
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};

#if 0
	regulators-5 {
		compatible = "qcom,pm8010-rpmh-regulators";
		qcom,pmic-id = "n";

		vdd-l1-l2-supply = <&vreg_s1c_1p25>;
		vdd-l3-l4-supply = <&vreg_s6c_1p86>;
		vdd-l5-supply = <&vreg_bob2>;

#if 0
		VREG_L1N_1P1
		VREG_L6N_2P8
		VREG_L7N_3P3
#endif
		vreg_l2n_1p056: ldo2 {
			regulator-name = "vreg_l2n_1p056";
			regulator-min-microvolt = <1056000>;
			regulator-max-microvolt = <1056000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on; // CAM TEST
		};

		vreg_l3n_1p8: ldo3 {
			regulator-name = "vreg_l3n_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on; // CAM TEST
		};

		vreg_l4n_1p8: ldo4 {
			regulator-name = "vreg_l4n_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on; // CAM TEST
		};

		vreg_l5n_2p8: ldo5 {
			regulator-name = "vreg_l5n_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on; // CAM TEST
		};
	};
#endif
};

&i2c3 {
	//clock-frequency = <1000000>;
	status = "okay";

	wcd939x_i2c@e {
		compatible = "qcom,wcd939x-i2c";
		reg = <0x0e>;
		// vdd-usb-cp-supply = <0x117>; l15b

		mode-switch;
		orientation-switch;

		svid = /bits/ 16 <0xff01>;
		port {
			fsa4480_ept: endpoint {
				remote-endpoint = <&typec_controller>;
			};
		};
	};
};

&mdss {
	status = "okay";
};

&mdss_mdp {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3i_1p2>;
	status = "okay";

	panel@0 {
		compatible = "visionox,vtdr6130";
		reg = <0>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&sde_dsi_active>, <&sde_te_active>;
		pinctrl-1 = <&sde_dsi_suspend>, <&sde_te_suspend>;

		vddio-supply = <&vreg_l12b_1p8>;
		vci-supply = <&vreg_l13b_3p0>;
		vdd-supply = <&vreg_l11b_1p2>;

		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l1i_0p88>;
	status = "okay";
};

&msm_dp {
	status = "okay";
	mode-switch;
	svid = /bits/ 16 <0xff01>;

	port {
		dp_mode: endpoint@0 {
			remote-endpoint = <&dp_mode_out>;
		};
	};
};

&pcie0 {
	vdda-supply = <&wlan_regulator>;

	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;

	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_default_state>;

	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1i_0p88>;
	vdda-pll-supply = <&vreg_l3i_1p2>;

	status = "okay";
};

&pm8550b_eusb2_repeater {
	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l05b_3p1>;
};

&pm8550b_typec {
	status = "okay";

	vdd-pdphy-supply = <&vreg_l05b_3p1>;
	vdd-vbus-supply = <&hboost>;

	connector {
		power-role = "dual";
		data-role = "dual";
		try-power-role = "sink";
		source-pdos = <PDO_FIXED(5000, 1500, PDO_FIXED_DUAL_ROLE | PDO_FIXED_DATA_SWAP |
		  PDO_FIXED_USB_COMM)>;
		sink-pdos = <PDO_FIXED(5000, 300, PDO_FIXED_DUAL_ROLE | PDO_FIXED_DATA_SWAP |
		  PDO_FIXED_USB_COMM)>;
		op-sink-microwatt = <15000000>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				pm8550b_role_switch_out: endpoint {
					remote-endpoint = <&usb_1_dwc3_role_switch_in>;
				};
			};

			port@1 {
				reg = <1>;

				typec_controller: endpoint {
					remote-endpoint = <&fsa4480_ept>;
				};
			};

			port@2 {
				reg = <2>;

				dp_mode_out: endpoint {
					remote-endpoint = <&dp_mode>;
				};
			};

#if 0
			port@1 {
				reg = <1>;

				pm8550b_typec_mux_out: endpoint {
					remote-endpoint = <&usb_1_qmpphy_typec_mux_in>;
				};
			};
#endif
		};
	};

};

&pmk8550_rtc {
	allow-set-time;
};

&qupv3_id_1 {
	status = "okay";
};

&qupv3_id_2 {
	status = "okay";
};

&uart14 {
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7850-bt";

		// XXX check these
		vddio-supply = <&vreg_l15b_1p8>;
		vddaon-supply = <&vreg_s3c_0p97>;
		vdddig-supply = <&vreg_s2c_0p85>;
		vddrfa0p8-supply = <&vreg_s3c_0p97>;
		vddrfa1p2-supply = <&vreg_s1c_1p25>;
		vddrfa1p9-supply = <&vreg_s6c_1p86>;

		max-speed = <3200000>;

		enable-gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
		swctrl-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;

		pinctrl-0 = <&bt_default>;
		pinctrl-names = "default";

		// XXX needs to be different for each device
		local-bd-address = [ 55 44 33 22 11 00 ];
	};
};

&uart15 {
	status = "okay";
};

#if 0
&qupv3_ssc {
	status = "okay";
};

&ssc_i2c9 {
	status = "okay";
};
#endif

&ufs_mem_hc {
	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1c_1p2>;
	vccq-max-microamp = <1200000>;

#if 0
	// l3c, s1c : 100 / 210000 microamp
	vccq2-supply = <&vreg_l3c_1p2>;
	vccq2-max-microamp = <100>;
#endif

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1d_0p91>;
	vdda-pll-supply = <&vreg_l3i_1p2>;

	status = "okay";
};

&usb_1 {
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "otg";
	usb-role-switch;
};

&usb_1_dwc3_role_switch_in {
	remote-endpoint = <&pm8550b_role_switch_out>;
};

&usb_1_hsphy {
	vdd-supply = <&vreg_l1i_0p88>;
	vdda12-supply = <&vreg_l3i_1p2>;

	phys = <&pm8550b_eusb2_repeater>;

	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l3i_1p2>;
	vdda-pll-supply = <&vreg_l3g_0p91>;
	//orientation-switch;

	status = "okay";
};

#if 0
&usb_1_qmpphy_typec_mux_in {
	remote-endpoint = <&pm8550b_typec_mux_out>;
};
#endif


&lpass_vamacro {
	//pinctrl-0 = <&dmic03_active>;
	//pinctrl-names = "default";
	//vdd-micb-supply = <&vreg_l14a_1p8>;
	qcom,dmic-sample-rate = <2400000>; /* or 3200000 */
};

&sound {
	status = "okay";
	codecs =
	<&left_spkr>, <&right_spkr>, <&swr0 0>,
	<&lpass_wsamacro 0>,
		 <&lpass_wsamacro 1>,
		 <&lpass_vamacro 0>, <&dummy_codec>, <&dummy_codec>;
};

&swr0 {
	status = "okay";

	/* WSA8845 */
	left_spkr: speaker@0,0 {
		compatible = "sdw20217020400";
		reg = <0 0>;
		//pinctrl-names = "default";
		//pinctrl-0 = <&spkr_1_sd_n_active>;
		powerdown-gpios = <&tlmm 186 GPIO_ACTIVE_LOW>; // LPASS 21
		#sound-dai-cells = <0>;
		sound-name-prefix = "SpkrLeft";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l3c_1p2>;
	};

	/* WSA8845 */
	right_spkr: speaker@0,1 {
		compatible = "sdw20217020400";
		reg = <0 1>;
		//pinctrl-names = "default";
		//pinctrl-0 = <&spkr_2_sd_n_active>;
		powerdown-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "SpkrRight";
		vdd-1p8-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l3c_1p2>;
	};
};
