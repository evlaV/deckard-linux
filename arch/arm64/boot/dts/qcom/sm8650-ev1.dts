&i2c4 {
	status = "okay";

    /* FAN_I2C */
	slg4ax46073v@8 {
		compatible = "silego,slg4ax46073v";
		reg = <0x08>;
		#address-cells = <1>;
		#size-cells = <0>;

		//vdd-fan-1-supply = <&VBATT_2S>; not modeled in dts
		fan-alert-gpios = <&tlmm 174 GPIO_ACTIVE_HIGH>;
		en-gpio = <&tlmm 138 GPIO_ACTIVE_HIGH>;
        // bp pin removed in ev1

		status = "ok";
	};
};

&cci2_i2c1 { // "CCI_5"
	cam_u@60 {
		compatible = "ovti,og0ve10x";
		reg = <0x60>;
        sensor-queue-index = <1>;
		dual-i2c-available = <1>;
		dual-i2c-main = <1>;

		reset-gpios = <&pm8550vs_c_gpios 5 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_sensor_mclk3_active>; // <&cam_6dof_ul_default>;

		clocks = <&camcc CAM_CC_MCLK3_CLK>;
		clock-names = "xclk";

		DOVDD-supply = <&VREG_6DOF_1V8_UL>;
		AVDD-supply = <&VREG_6DOF_2P8_UL>;
		DVDD-supply = <&VREG_6DOF_1V2_UL>;

		id = "upper_left";

		port {
			cam_6dof_ul: endpoint {
				clock-lanes = <3>;
				data-lanes = <2>;
				remote-endpoint = <&csiphy0_combo_ep>;
			};
		};
	};

	cam_u@3e {
		compatible = "ovti,og0ve10x";
		reg = <0x3E>;
        sensor-queue-index = <1>;
		dual-i2c-available = <1>;
		dual-i2c-main = <0>;

		reset-gpios = <&pm8550vs_c_gpios 6 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 68 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_sensor_mclk5_active>; // <&cam_6dof_ur_default>;

		clocks = <&camcc CAM_CC_MCLK5_CLK>;
		clock-names = "xclk";

		DOVDD-supply = <&VREG_6DOF_1V8_UR>;
		AVDD-supply = <&VREG_6DOF_2P8_UR>;
		DVDD-supply = <&VREG_6DOF_1V2_UR>;

		id = "upper_right";

		port {
			cam_6dof_ur: endpoint {
				clock-lanes = <3>;
				data-lanes = <2>;
				remote-endpoint = <&csiphy1_combo_ep>;
			};
		};
	};
};

&cci2_i2c0 { // "CCI_4"
	cam@60 {
		compatible = "ovti,og01a1bx";
		reg = <0x60>;
        sensor-queue-index = <0>;
		dual-i2c-available = <1>;
		dual-i2c-main = <1>;

		reset-gpios = <&pm8550vs_e_gpios 6 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 123 GPIO_ACTIVE_HIGH>;
		ircontrol-gpios = <&tlmm 200 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_sensor_mclk1_active>; // <&cam_6dof_l_default>;

		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		clock-names = "xclk";

		DOVDD-supply = <&VREG_6DOF_1V8_L>;
		AVDD-supply = <&VREG_6DOF_2P8_L>;
		DVDD-supply = <&VREG_6DOF_1V2_L>;

		id = "slam_left";

		port {
			cam_6dof_l: endpoint {
				clock-lanes = <4>;
				data-lanes = <0 1>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};

	cam@36 {
		compatible = "ovti,og01a1bx";
		reg = <0x36>;
        sensor-queue-index = <0>;
		dual-i2c-available = <1>;
		dual-i2c-main = <0>;

		reset-gpios = <&pm8550vs_e_gpios 4 GPIO_ACTIVE_LOW>;
		strobe-gpios = <&tlmm 121 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cam_sensor_mclk0_active>; // <&cam_6dof_r_default>;

		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		clock-names = "xclk";

		DOVDD-supply = <&VREG_6DOF_1V8_R>;
		AVDD-supply = <&VREG_6DOF_2P8_R>;
		DVDD-supply = <&VREG_6DOF_1V2_R>;

		id = "slam_right";

		port {
			cam_6dof_r: endpoint {
				clock-lanes = <4>;
				data-lanes = <0 1>;
				remote-endpoint = <&csiphy1_ep>;
			};
		};
	};
};

&pm8550b_typec {
    disable-cell-balancing;
};

&i2c_hub_8 {
    /* MAX98390 */
    right_spkr_i2s: speaker@38 {
        compatible = "maxim,max98390";
        reg = <0x38>;
        maxim,temperature_calib = <1024>; // TODO
        maxim,r0_calib = <100232>; // TODO
        reset-gpios = <&tlmm 73 GPIO_ACTIVE_LOW>;
        // irq-gpios = <&tlmm 186 GPIO_ACTIVE_LOW>;  XXX TODO add IRQ support to driver, set as open drain
        #sound-dai-cells = <0>;
        sound-name-prefix = "Speaker Right";
    };

    /* MAX98390 */
    left_spkr_i2s: speaker@3d {
        compatible = "maxim,max98390";
        reg = <0x3d>;
        maxim,temperature_calib = <1024>; // TODO
        maxim,r0_calib = <100232>; // TODO
        reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
        // irq-gpios = <&tlmm 77 GPIO_ACTIVE_LOW>;  XXX TODO add IRQ support to driver, set as open drain
        #sound-dai-cells = <0>;
        sound-name-prefix = "Speaker Left";
    };
};

&sound {
    enable-i2s;
    // enable-hdmi;
    codecs =
       <&left_spkr_i2s>, <&right_spkr_i2s>,
       <&lpass_vamacro 0>;

    pinctrl-0 = <&i2s2_active>;
    pinctrl-names = "default";
};

// Disable Soundwire
&wsa_swr_active {
	status = "disabled";
};

&wsa_swr_sleep {
	status = "disabled";
};

&mdss_dsi0 {
	panel: panel@0 {
		// backlight ramp setup
		backlight_ramp_step_size = <10>;
		backlight_ramp_step_time_msec = <50>;
	};
};
