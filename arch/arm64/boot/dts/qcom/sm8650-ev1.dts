/dts-v1/;

#include "sm8650-deckard.dtsi"

/ {
    model = "SM8650 EV1 rev1 4slam 2et";

	BACKLIGHT: backlight {
		compatible = "valve-backlight";
		preboost-gpio = <&tlmm 79 GPIO_ACTIVE_HIGH>;
		en-gpios = <&pm8550_gpios 1 GPIO_ACTIVE_HIGH>,
			   <&pm8550_gpios 2 GPIO_ACTIVE_HIGH>;
		i2c-adapter = <&i2c4 &i2c5>;
	};

	VREG_6DOF_1V8 {
		compatible = "regulator-fixed2";
		gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>,
			<&tlmm 12 GPIO_ACTIVE_HIGH>;
		r-supply = <&VREG_L5M_1P8>;
		l-supply = <&VREG_L5N_1P8>;

		VREG_6DOF_1V8_R: r0 {
			regulator-name = "6DOF_1V8_R";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
		VREG_6DOF_1V8_UR: r1 {
			regulator-name = "6DOF_1V8_UR";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
		VREG_6DOF_1V8_L: l0 {
			regulator-name = "6DOF_1V8_L";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
		VREG_6DOF_1V8_UL: l1 {
			regulator-name = "6DOF_1V8_UL";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
	};

	VREG_6DOF_1V2 {
		compatible = "regulator-fixed2";
		gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>,
			<&tlmm 15 GPIO_ACTIVE_HIGH>;
		r-supply = <&VREG_L2M_1P2>;
		l-supply = <&VREG_L2N_1P2>;

		VREG_6DOF_1V2_R: r0 {
			regulator-name = "6DOF_1V2_R";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
		VREG_6DOF_1V2_UR: r1 {
			regulator-name = "6DOF_1V2_UR";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
		VREG_6DOF_1V2_L: l0 {
			regulator-name = "6DOF_1V2_L";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
		VREG_6DOF_1V2_UL: l1 {
			regulator-name = "6DOF_1V2_UL";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
	};

	FPGA_clk: FPGA_clk {
		compatible = "fpga-clock";
		#clock-cells = <0>;
		clock-output-names = "fpga_clk";
		status = "okay";

		pinctrl-names = "default";
		pinctrl-0 = <&FPGA_clk_default>;

		clocks = <&gcc GCC_GP3_CLK>;
		clock-frequency = <24000000>;
		clock-names = "pinclk";
	};

	fpga: fpga {
		compatible = "valve,fpga";

		clocks = <&FPGA_clk>;
		clock-names = "fpga_clk";
		v1v1-supply = <&VREG_L2G_1P1>;
		pwren-gpio = <&tlmm 75 GPIO_ACTIVE_HIGH>;
	};
};

&fpga {
	// Setup FPGA Userspace Pin States
	pinctrl-0 = <&fpga_cready>, <&fpga_cs>, <&fpga_crst>, <&fpga_cdone>, <&fpga_rst>;
	pinctrl-names = "default";

	status = "okay";
};

&apps_rsc {
    regulators-6 {
        vdd-l6-supply = <&VREG_BOB2>;
    };
    regulators-7 {
        vdd-l6-supply = <&VREG_BOB2>;
    };
};

&pcie1 {
	vdda-supply = <&VPH_PWR>;
	vddpe-3v3-supply = <&VPH_PWR>; // XXX

	wake-gpios = <&tlmm 99 GPIO_ACTIVE_HIGH>;
	perst-gpios = <&tlmm 97 GPIO_ACTIVE_LOW>;

	pinctrl-0 = <&pcie1_default_state>;
	pinctrl-names = "default";

	status = "okay";
};

&pcie1_phy {
	vdda-phy-supply = <&VREG_L3E_0P9>;
	vdda-pll-supply = <&VREG_L3I_1P2>;
	vdda-qref-supply = <&VREG_L1I_0P88>;

	status = "okay";
};

&i2c5 {
	status = "okay";
    // BOOT EEPROM
    eeprom_core@50 {
        compatible  = "atmel,24c32";
        status      = "okay";
		label		= "core_eeprom";
        reg         = <0x50>;
        wp-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
        vcc-supply  = <&VREG_L15B_1P8>;
    };

    max34417_1: max34417@12 {
        compatible = "maxim,max34417";
        reg = <0x12>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&VDD_SENSOR_3V3>;
        vio-supply = <&VREG_L15B_1P8>;
        status = "okay";

        // CH 1 : Kryo APC1 Cores
        // CH 2 : Kryo APC2 Cores
        // CH 3 : Kryo APC0 Cores
        // CH 4 : Tensor Processor – NSP1
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    };

    max34417_2: max34417@1a {
        compatible = "maxim,max34417";
        reg = <0x1a>;
        maxim,sense-resistor = <1>;
        vdd-supply = <&VDD_SENSOR_3V3>;
        vio-supply = <&VREG_L15B_1P8>;
        status = "okay";

        // CH 1 : GFX Power
        // CH 2 : Tensor Processor – NSP2
        // CH 3 : VPH Power
        // CH 4 : Unused
        // Note: both 1.8 and 3.0V rails are always on for other sensors
    }; 
};

// Custom Connector I2C ( Paddle Card )
&i2c2 {
	status = "okay";

	max17320@36 {
		compatible  = "maxim,max17320";
		status				= "okay";
		reg         = <0x36>;
		rsense      = <25>;      /* 100's of microOhms */
		// talrt-min   = <0>;       /* DegreeC */
		// talrt-max   = <50>;      /* DegreeC */
		// valrt-min   = <3000>;    /* mV */
		// valrt-max   = <4500>;    /* mV */
		// salrt-min   = <1>;       /* Percent */
		// salrt-max   = <99>;      /* Percent */
		// ialrt-min   = <(-5000)>; /* mA */
		// ialrt-max   = <5000>;    /* mA */
	};

    // PADDLE EEPROM
    eeprom@50 {
        compatible  = "atmel,24c32";
        status      = "okay";
		label		= "strap_eeprom";
        reg         = <0x50>;
        //wp-gpios = <&tlmm 78 GPIO_ACTIVE_HIGH>;
        vcc-supply  = <&VREG_L15B_1P8>;
    };

	// Northgate/Enthusiast Paddle Card Silego
	slg46534v@48 {
		compatible = "silego,northgate";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;

		status = "ok";
	};
};

&pm8550ve_gpios {
	gpio-line-names =
		// GPIO01 - GPIO08
		"",  "",  "",  "",  "",  "",  "",  "";
};

// FPGA SPI and Pin setup
// Disable SPI7 from base POCF config
&spi7 {
	status = "disabled";
};

&spi0 {
	status = "okay";

	// Remove Hardware Chip Select
	pinctrl-0 = <&qup_spi0_data_clk>;

	cspi@0 {
		status = "okay";
		compatible = "linux,spidev";
		spi-max-frequency = <8000000>;
		reg = <0>;
	};
};

&tlmm {
	// TODO verify reserved pins for 8650
	// qcom,gpios-reserved = <36 37 38 39>;
	gpio-line-names =
		// GPIO000 - GPIO015
		"",  "",  "",  "",  "",  "",  "",  "fpga_rst",  "",  "",  "",  "nrf_time_sync",  "",  "",  "",  "",
		// GPIO016 - GPIO031
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO032 - GPIO047
		"",  "",  "",  "fpga_spi_cs",  "",  "",  "",  "fpga_crst",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO048 - GPIO063
		"",  "",  "nrf_swdio",  "nrf_swclk",  "",  "",  "",  "",  "fpga_cam0_strobe",  "fpga_cam1_strobe",  "",  "",  "",  "",  "",  "",
		// GPIO064 - GPIO079
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO080 - GPIO095
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO096 - GPIO111
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "fpga_cam1_frame_sync",  "",
		// GPIO112 - GPIO127
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "fpga_cam0_frame_sync",  "",  "",  "",
		// GPIO128 - GPIO143
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO144 - GPIO159
		"",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "fpga_cdone",  "",  "",  "fpga_cready",  "",
		// GPIO160 - GPIO175
		"",  "",  "",  "",  "nrf_reset",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",  "",
		// GPIO176 - GPIO189
		"",  "",  "",  "",  "", "", "", "", "", "", "", "", "", "";
};

&tlmm {
	status = "ok";

	// FPGA Pins
	fpga_rst: fpga_rst {
		mux {
			pins = "gpio7";
			function = "gpio";
		};

		config {
			pins = "gpio7";
			bias-disable = <0>;
			input-enable;
		};
	};

	fpga_cs: fpga_cs {
		mux {
			pins = "gpio35";
			function = "gpio";
		};

		config {
			pins = "gpio35";
			bias-disable = <0>;
			drive-strength = <2>;
			output-enable;
			// active-low;
			output-high;
		};
	};

	fpga_crst: fpga_crst {
		mux {
			pins = "gpio39";
			function = "gpio";
		};

		config {
			pins = "gpio39";
			bias-disable = <0>;
			input-enable;
		};
	};

	fpga_cdone: fpga_cdone {
		mux {
			pins = "gpio155";
			function = "gpio";
		};

		config {
			pins = "gpio155";
			bias-disable = <0>;
			input-enable;
		};
	};	

	fpga_cready: fpga_cready {
		mux {
			pins = "gpio158";
			function = "gpio";
		};

		config {
			pins = "gpio158";
			bias-disable = <0>;
			input-enable;
		};
	};
};

// nRF Pins
&tlmm {
	// nRF CS
	qup_spi10_cs_nrf: qup-spi10-cs-state-nrf {
		pins = "gpio13";
		function = "qup2_se2";
		drive-strength = <6>;
		bias-disable;
	};

	// nRF SPI interrupt and reset pins
	host_spihid_default_state: host-spihid-default {
		irq0 {
			pins = "gpio66";
			function = "gpio";
			bias-pull-up;
		};

		reset0 {
			pins = "gpio137";
			function = "gpio";
			drive-strength = <2>;
			output-low;
			bias-pull-down;
		};
	};
};

#ifndef NRF_UART
// nRF SPI HID
&spi10 {
	status = "okay";

	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_cs_nrf>;
	pinctrl-names = "default";

	hid@1 {
		compatible = "hid-over-spi";
		reg = <1>;
		interrupts-extended = <&tlmm 66 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 137 GPIO_ACTIVE_LOW>;
		//vdd-supply = <&vdd_3v3_reg>;
		input-report-header-address = <0x1000>;
		input-report-body-address = <0x1004>;
		output-report-address = <0x2000>;
		read-opcode = <0x0b>;
		write-opcode = <0x02>;
		hid-over-spi-flags = <0x00>;
		post-power-on-delay-ms = <1>;
		minimal-reset-delay-ms = <100>;
		pinctrl-names = "default";
		pinctrl-0 = <&host_spihid_default_state>;
    };
};
#endif

