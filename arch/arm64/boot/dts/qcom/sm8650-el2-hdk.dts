#include "sm8650-hdk.dts"
#include "sm8650-el2.dtsi"

#if 1 // display card
/* Disable HDMI bridge related nodes (mutually exclusive with the display card) */

&i2c6 {
	status = "disabled";
};

&lt9611_1v2 {
	status = "disabled";
};

&lt9611_3v3 {
	status = "disabled";
};

&vreg_bob_3v3 {
	status = "disabled";
};

/delete-node/ &lt9611_codec;
/ {
	/delete-node/ hdmi-out;
};

&mdss_dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "visionox,vtdr6130";
		reg = <0>;

		reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;

		vddio-supply = <&vreg_l12b_1p8>;
		vci-supply = <&vreg_l13b_3p0>;
		vdd-supply = <&vreg_l11b_1p2>;

		pinctrl-0 = <&disp0_reset_n_active>, <&mdp_vsync>;
		pinctrl-1 = <&disp0_reset_n_suspend>, <&mdp_vsync>;
		pinctrl-names = "default", "sleep";

		port {
			panel0_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			mdss_dsi0_out: endpoint {
				remote-endpoint = <&panel0_in>;
			};
		};
	};
};

#if 0
&spi4 {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	touchscreen@0 {
		compatible = "goodix,gt9916";
		reg = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_LEVEL_LOW>;

		reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;

		avdd-supply = <&vreg_l14b_3p2>;

		spi-max-frequency = <1000000>;

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;

		pinctrl-0 = <&ts_irq>, <&ts_reset>;
		pinctrl-names = "default";
	};
};
#endif

&tlmm {
	disp0_reset_n_active: disp0-reset-n-active-state {
		pins = "gpio133";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
		pins = "gpio133";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync: mdp-vsync-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_irq: ts-irq-state {
		pins = "gpio161";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		output-disable;
	};

	ts_reset: ts-reset-state {
		pins = "gpio162";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};
#endif

/ {
	sound {
		compatible = "qcom,lpass-sndcard";
		model = "SM8650-HDK-LPASS";

		wcd-playback {
			link-name = "WCD Playback";

			platform {
				sound-dai = <&lpass_rxtx_lpaif LPAIF_RXTX_CODEC_RX_01>;
			};

			codec {
				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};
		};

		wcd-mix-playback {
			link-name = "WCD MIX Playback";

			platform {
				sound-dai = <&lpass_rxtx_lpaif LPAIF_RXTX_CODEC_RX_23>;
			};

			codec {
				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 1>;
			};
		};

		wsa {
			link-name = "WSA Playback";

			platform {
				sound-dai = <&lpass_wsa_lpaif LPAIF_WSA_CODEC_RX_01>;
			};

			codec {
				sound-dai = <&north_spkr>, <&south_spkr>, <&swr0 0>, <&lpass_wsamacro 0>;
			};
		};

		wsa-mix {
			link-name = "WSA MIX Playback";

			platform {
				sound-dai = <&lpass_wsa_lpaif LPAIF_WSA_CODEC_RX_23>;
			};

			codec {
				sound-dai = <&north_spkr>, <&south_spkr>, <&swr0 0>, <&lpass_wsamacro 1>;
			};
		};

		dp {
			link-name = "DisplayPort Playback";

			platform {
				sound-dai = <&lpass_hdmitx 0>;
			};

			codec {
				sound-dai = <&mdss_dp0>;
			};
		};

		wcd-capture {
			link-name = "WCD Capture";

			platform {
				sound-dai = <&lpass_rxtx_lpaif LPAIF_RXTX_CODEC_TX>;
			};

			codec {
				sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>;
			};
		};

		/* note: ECHO / VI don't link to soundwire codecs - read zeros anyway when nothing is playing */
		wcd-echo {
			link-name = "WCD ECHO Capture";

			platform {
				sound-dai = <&lpass_rxtx_lpaif LPAIF_WSA_CODEC_TX_ECHO>;
			};

			codec {
				sound-dai = <&lpass_rxmacro 4>;
			};
		};

		wsa-vi {
			link-name = "WSA VI Capture";

			platform {
				sound-dai = <&lpass_wsa_lpaif LPAIF_WSA_CODEC_TX_VI>;
			};

			codec {
				sound-dai = <&lpass_wsamacro 2>;
			};
		};

		wsa-echo {
			link-name = "WSA ECHO Capture";

			platform {
				sound-dai = <&lpass_wsa_lpaif LPAIF_WSA_CODEC_TX_ECHO>;
			};

			codec {
				sound-dai = <&lpass_wsamacro 3>;
			};
		};
	};
};

&wcd_usbss_sbu_mux {
	remote-endpoint = <&typec_controller>;
};
